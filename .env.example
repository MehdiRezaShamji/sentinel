# ---- Required ----

# FortyGuard environmental intelligence API
FORTYGUARD_API_KEY=your_fortyguard_api_key

# Groq LLM (agent reasoning layer)
GROQ_API_KEY=your_groq_api_key

# Telegram bot for worker safety check-ins (create via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Demo mode: 20s check-in timeout and 1s poll interval
DEMO_MODE=true

# ---- Optional ----

# Production check-in timeout in seconds (ignored when DEMO_MODE=true)
# CHECKIN_TIMEOUT_SECONDS=300

# Supervisor alert destination (simulated demo actor by default)
# SUPERVISOR_PHONE=+15550000999

# FortyGuard environment refresh interval in seconds (default 4 hours)
# FORTYGUARD_REFRESH_SECONDS=14400

# CORS for a deployed frontend, e.g.:
# ALLOWED_ORIGIN_REGEX=^https://sentinel-frontend\.onrender\.com$

# Frontend: backend API base URL (set at build time on the static host)
# VITE_API_URL=https://sentinel-backend.onrender.com/api
